# ==============================================================================
# FinSight Environment Configuration
# Copy this file to .env and replace placeholder values with your local settings.
# Never commit the .env file to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Analytical Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finsight_db
DB_USER=finsight_user
DB_PASSWORD=your_secure_password_here
DB_SCHEMA=public

# Pipeline Execution Settings
PIPELINE_CONFIG_PATH=config/pipeline.yaml
RISK_RULES_CONFIG_PATH=config/risk_rules.yaml

# Data Paths (relative to project root or absolute paths)
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
SAMPLE_DATA_PATH=data/sample
DQ_REPORTS_PATH=reports/data_quality
