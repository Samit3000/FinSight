# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS-generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Project Data (Preserve structure via .gitkeep, ignore generated data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Sample data can be kept if small, but ignore ad-hoc dumps
data/sample/*
!data/sample/.gitkeep

# Raw Large Datasets (PaySim)
PS_*.csv
*.csv.gz
*.csv.zip

# Quality Reports & Logs
reports/data_quality/*
!reports/data_quality/.gitkeep
*.log
logs/

# Database dumps and local database files
*.sql.gz
*.dump
*.sqlite3

# Power BI local cache and user state
*.pbix.temp
~*
